{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "ppq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32767
    },
    "tempoBpm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "timeSignature": {
      "type": "object",
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "denominator": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            },
            {
              "type": "number",
              "const": 4
            },
            {
              "type": "number",
              "const": 8
            },
            {
              "type": "number",
              "const": 16
            },
            {
              "type": "number",
              "const": 32
            },
            {
              "type": "number",
              "const": 64
            },
            {
              "type": "number",
              "const": 128
            }
          ]
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "additionalProperties": false
    },
    "audioAssets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "mimeType": {
            "type": "string",
            "enum": [
              "audio/wav",
              "audio/webm",
              "audio/ogg"
            ]
          },
          "sampleRateHz": {
            "type": "integer",
            "minimum": 1,
            "maximum": 384000
          },
          "channels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "durationSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "path",
          "mimeType",
          "sampleRateHz",
          "channels",
          "durationSeconds"
        ],
        "additionalProperties": false
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "midiChannel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "program": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "sourceAudioId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "pitch": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 127
                },
                "velocity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 127
                },
                "startTick": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "durationTicks": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "id",
                "pitch",
                "velocity",
                "startTick",
                "durationTicks"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "midiChannel",
          "program",
          "notes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "ppq",
    "tempoBpm",
    "timeSignature",
    "audioAssets",
    "tracks"
  ],
  "additionalProperties": false
}
